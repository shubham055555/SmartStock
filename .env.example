# SmartStock Environment Configuration Template
# Copy this file to .env and customize for local or production use

# Application Settings
NODE_ENV=development
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=smartstock-super-secure-production-secret-key-change-me
JWT_SECRET_KEY=jwt-smartstock-super-secret-token-key-change-me
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=120

# Database Configuration
# For local development with SQLite fallback:
# DATABASE_URL=sqlite:///smartstock.db
# For PostgreSQL (Docker or Cloud):
DATABASE_URL=postgresql://smartstock_user:smartstock_password@localhost:5432/smartstock_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smartstock_db
DB_USER=smartstock_user
DB_PASSWORD=smartstock_password

# Frontend & CORS
FRONTEND_PORT=5173
BACKEND_PORT=5000
VITE_API_BASE_URL=http://localhost:5000/api
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Monitoring & Metrics
PROMETHEUS_METRICS_ENABLED=true
METRICS_PORT=5000

# Bonus AI Log Analysis
# Optional external provider (e.g., openai, gemini, or leave blank/deterministic for built-in rule engine)
AI_LOG_PROVIDER=deterministic
AI_LOG_API_KEY=
